{
    name: "librechat",
    profile: "paravirt",
    compression: "xz",

    packages: [
        "genpack/paravirt",

        // バックエンド実行時 (api/server/index.js)。フロントビルドにも使う。
        // LibreChat の package.json に engines 制限はなく node 26 系で検証済み。
        "net-libs/nodejs",

        // LibreChat の必須外部サービス。v0.8.8 の公式 docker-compose が mongo:8.0 を載せるのが
        // 基準構成で、mongoose 8 / mongodb driver 6 系は 8.0 サーバーを完全サポート (制約なし)。
        // 8.0.29 は amd64 安定 (8.0.34 / 8.3 系は ~amd64 なのでキーワードstable選択で自動除外)。
        // ebuild が mongodb.service を同梱し、acct-user/acct-group/mongodb を RDEPEND に持つ。
        // 7 系データ (FCV 7.0) への被せは 7.0 → 8.0 が公式の直接 upgrade path なので起動する。
        // FCV 引き上げは不要 (8.0 バイナリが FCV 7.0 のまま動く)。
        "=dev-db/mongodb-8*",

        // librechat ユーザーに NOPASSWD でサービス再起動をさせる (files/etc/sudoers.d)。
        // genpack/base プロファイルには含まれないので明示的に立てる。
        "app-admin/sudo",

        // ビルド時のシャロークローンに加え、インスタンス側で MCP サーバーを
        // GitHub から clone して運用する用途で実行時にも必要。
        "dev-vcs/git",

        // MCP サーバーに渡す API 鍵を UID keyring に投入する (keyctl padd ... @u)。
        // user キーはディスクに永続化されないため、鍵をファイルシステムに残さない運用に使う。
        "sys-apps/keyutils",

        // インスタンス側で Python 製の stdio MCP サーバーを動かすため。
        // 現在のイメージに入っているのは他パッケージの依存の副産物なので宣言する。
        "dev-lang/python",
    ],

    // (廃止) mongodb-7.0.28 は SConstruct が `from pkg_resources import parse_version` を使うのに
    // ebuild の BDEPEND が pkg-resources を宣言せず、dev-python/pkg-resources の先行導入が要った
    // (buildtime_packages_first)。mongodb-8 系は dev-python/packaging を BDEPEND に持つので不要。

    // ref: exec-guard
    // overlayfs upper layer に持ち込まれた ELF バイナリ・共有ライブラリの実行を eBPF LSM でブロック。
    // /opt/librechat (node_modules のネイティブアドオン含む) は SquashFS lower 側なので実行に影響しない。
    // clang / bpftool は genpack-overlay の ebuild が自動依存。無効化は system.ini の `exec_guard = false`。
    use: {
        "sys-apps/genpack-init": "exec-guard",
        "dev-cpp/simdutf": "atomic-base64",
    },

    accept_keywords: {
    },

    license: {
        // mongodb の LICENSE="Apache-2.0 SSPL-1"
        "dev-db/mongodb": "SSPL-1",
    },

    arch: {
        aarch64: {
            // mongodb は arm64 で全て ~arch (8.0.29 で amd64 のみ安定)
            accept_keywords: {
                "dev-db/mongodb": null,
            },
        },
    },

    users: [
        // 設定編集やサービス再起動をこのユーザーで行う運用 (sudoers で部分特権)
        { name: "librechat", uid: 1000, home: "/var/lib/librechat", shell: "/bin/bash" },

        // 過去チャット検索の Meilisearch (プリビルドバイナリは build.d で lower に焼く)。
        // dbPath /var/lib/meilisearch (ユーザーホーム兼用) の所有者。
        // create_home: false は必須。skel のドットファイルが dbPath に入ると Meilisearch が
        // "failed to infer the version of the database" で起動しない。
        // genpack が useradd へ -M を渡す修正 (genpack 1f4eecf) 以降の genpack が必要。
        { name: "meilisearch", uid: 1001, home: "/var/lib/meilisearch", shell: "/sbin/nologin", create_home: false },
    ],

    services: ["mongodb", "meilisearch", "librechat","vsock-export@3080.socket"],
}
